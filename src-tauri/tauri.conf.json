{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "雪绒人机管理器",
  "version": "2.6.0",
  "identifier": "com.xuerong.botmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "雪绒人机管理器",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#f7f3fb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/CS2BotImprover.zip": "resources/CS2BotImprover.zip"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "copyright": "雪绒人机管理器",
    "category": "Utility",
    "shortDescription": "CS2 人机插件管理工具",
    "longDescription": "雪绒人机管理器 — 一键安装与管理 CS2 人机插件，含 XP 勋章与击杀图标皮肤模块。"
  }
}