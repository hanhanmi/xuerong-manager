{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEMEATH",
  "version": "1.4.2",
  "identifier": "com.xuerong.botmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "change my mind",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#f7f3fb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/CS2BotImprover.zip": "resources/CS2BotImprover.zip",
      "resources/mvp-music/*": "resources/mvp-music"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "copyright": "AEMEATH",
    "category": "Utility",
    "shortDescription": "CS2 人机插件管理工具",
    "longDescription": "AEMEATH — 一键安装与管理 CS2 人机插件，含 XP 勋章、击杀图标、优先分数与 MVP 音乐。"
  }
}
